# Sanity CMS
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production

# Google Gemini (existing)
GEMINI_API_KEY=your_gemini_api_key

# Resend email (existing)
RESEND_API_KEY=your_resend_api_key
LEADS_FROM_EMAIL="Studio Austinn <hello@studioaustinn.com>"
LEADS_TO_EMAIL=recipient@example.com

# Stripe — shop checkout
# Server-side secret: used only in /api/create-checkout-session.ts (never exposed to browser)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
# Client-side publishable key: safe to expose to browser (VITE_ prefix required by Vite)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
